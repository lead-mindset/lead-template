# Copy to .env.local and fill in. Never commit real values.

# Route this app is served under by leadmain (Multi Zones), e.g. /talent, /pulse, /aspire.
# Leave empty to serve the app at the root. Must match in .env.local and in Vercel.
NEXT_PUBLIC_BASE_PATH=

# Public origin users see, without the base path (e.g. https://www.leadmindset.org, or http://localhost:3000 locally).
# Used to build OAuth redirect URLs and auth callback redirects.
NEXT_PUBLIC_SITE_URL=

# Supabase project URL (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Project Settings > API). Safe for the browser; protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Server only: bypasses RLS. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key for transactional email (server only).
RESEND_API_KEY=
